{
  // Select optional support profiles here; permissions from selected profiles combine additively.
  "meta": {
    "name": "agent-linux-local",
    "version": "1.0.0",
    "description": "Shared Linux agent policy with session-scoped temporary state"
  },
  "extends": [
    // Always retain the common Linux isolation, credential denials and exact temporary-directory grant.
    "agent-linux-base",
    // Select .NET CLI tools, NuGet reads and the .NET session-state variables.
    "support-dotnet",
    // Select installed Rust/Cargo executables and disposable Cargo state.
    "support-rust",
    // Select the upstream Python runtime grants.
    "support-python",
    // Select Node runtime grants and read-only pnpm storage.
    "support-node",
    // Select upstream access needed by installed Nix tools.
    "support-nix",
    // Select host Git settings used for project operations.
    "support-git",
    // Select the mise manager and installed tool versions without a launcher-only extension.
    "support-mise",
    // Retain the supplied Neovim runtime access; omit if editor use is unnecessary.
    "support-editor",
    // Retain the supplied Stride installation access; writable state remains unconfigured.
    "support-stride"
  ]
}
